{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Rig Studio",
  "version": "1.0.1",
  "identifier": "com.pixelrigstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixel Rig Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}
